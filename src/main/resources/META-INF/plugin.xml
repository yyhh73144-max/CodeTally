<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.yyhh73144max.codetally</id>
    <name>CodeTally</name>
    <vendor>yyhh73144-max</vendor>
    <description><![CDATA[
        <p><b>CodeTally</b> counts files, total/code/comment/blank lines and functions per file type
        (Kotlin, Java, C/C++, XML) for the whole project or any selected directory in Android Studio.</p>
        <p>CodeTally 是一款 Android Studio 代码统计插件：</p>
        <ul>
            <li>按文件类型（Kotlin、Java、C/C++、XML）统计文件数、总行数、代码行、注释行、空行与函数数，并给出全部合计；</li>
            <li>统计整个项目，或在项目视图中右键统计任意目录/文件；</li>
            <li>自动排除库、生成源码、Gradle build 输出与隐藏缓存目录（.gradle、.gradle-user、.idea、.cxx 等）；</li>
            <li>项目级自定义排除文件夹（Settings › Tools › CodeTally 代码统计，或右键“在代码统计中排除”），可随项目共享；</li>
            <li>工具窗口支持排序、按语言筛选、双击打开文件，数字可切换为中文万/亿格式；</li>
            <li>函数数基于轻量词法分析估算，不依赖语言插件，未安装 C/C++ 支持时同样可用。</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.CodeTallyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeTally" anchor="bottom" icon="AllIcons.Actions.ListFiles"
                    factoryClass="com.github.yyhh73144max.codetally.toolWindow.CodeTallyToolWindowFactory"/>
        <projectConfigurable parentId="tools" id="codetally.settings" key="settings.displayName"
                             instance="com.github.yyhh73144max.codetally.settings.CodeTallyConfigurable"/>
    </extensions>

    <actions>
        <action id="CodeTally.TallyProject" icon="AllIcons.Actions.Execute"
                class="com.github.yyhh73144max.codetally.actions.TallyProjectAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="CodeTally.TallySelection"
                class="com.github.yyhh73144max.codetally.actions.TallySelectionAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="CodeTally.ToggleExclude"
                class="com.github.yyhh73144max.codetally.actions.ToggleExcludeFolderAction">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="CodeTally.TallySelection"/>
        </action>
        <action id="CodeTally.OpenSettings" icon="AllIcons.General.Settings"
                class="com.github.yyhh73144max.codetally.actions.OpenTallySettingsAction"/>
    </actions>
</idea-plugin>
